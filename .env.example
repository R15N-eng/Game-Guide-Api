# Copie este arquivo para .env e preencha. Nunca faça commit do .env.
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gameguide

# Sites que podem chamar a API pelo navegador, separados por vírgula. Vazio = nenhum.
# Apps móveis e ferramentas como Postman não dependem de CORS.
CORS_ORIGINS=

# Defina como 1 só se a API estiver atrás de um proxy reverso (para o limite por IP).
TRUST_PROXY=

# Obrigatório, com pelo menos 32 caracteres. Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
